{
  "openapi": "3.0.3",
  "info": {
    "title": "CrazyClaw Server Chat API",
    "version": "0.1.0",
    "description": "Chat streaming APIs for CrazyClaw. Chat endpoints return Server-Sent Events directly and do not use the standard JSON ApiResponse wrapper."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "tags": [
    {
      "name": "Chat",
      "description": "Stream agent chat responses."
    }
  ],
  "paths": {
    "/api/chat": {
      "get": {
        "tags": ["Chat"],
        "summary": "Stream chat by query",
        "description": "Convenience testing endpoint. It converts `input` into a user message and streams the same OpenAI-compatible SSE response as `POST /api/chat`. The current implementation uses hard-coded `coder` agent and `qwen` model.",
        "operationId": "testChatByQuery",
        "x-apifox-folder": "Chat",
        "parameters": [
          {
            "name": "input",
            "in": "query",
            "required": true,
            "description": "User input message.",
            "schema": {
              "type": "string",
              "example": "你好，你是谁？"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/OpenAIStream"
          },
          "400": {
            "description": "Input is empty"
          }
        }
      },
      "post": {
        "tags": ["Chat"],
        "summary": "Stream chat",
        "description": "Main chat endpoint used by the web chat page. The request body follows the OpenAI chat-completions shape enough for Ant Design X's OpenAI provider. The current implementation reads the latest user message and uses hard-coded `coder` agent and `qwen` model.",
        "operationId": "testChat",
        "x-apifox-folder": "Chat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenAIChatRequest"
              },
              "example": {
                "model": "glm-4.5-flash",
                "stream": true,
                "messages": [
                  {
                    "role": "user",
                    "content": "你好，你是谁？"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/OpenAIStream"
          },
          "400": {
            "description": "Input is empty"
          }
        }
      }
    },
    "/api/chat/stream": {
      "get": {
        "tags": ["Chat"],
        "summary": "Stream chat response",
        "description": "Opens a Server-Sent Events stream. Query fields are optional in the current skeleton and will become required when the internal chat logic is implemented.",
        "operationId": "streamChat",
        "x-apifox-folder": "Chat",
        "parameters": [
          {
            "name": "agentName",
            "in": "query",
            "required": false,
            "description": "Agent configuration id.",
            "schema": {
              "type": "string",
              "example": "coder"
            }
          },
          {
            "name": "modelName",
            "in": "query",
            "required": false,
            "description": "Model configuration id.",
            "schema": {
              "type": "string",
              "example": "qwen"
            }
          },
          {
            "name": "message",
            "in": "query",
            "required": false,
            "description": "User input message.",
            "schema": {
              "type": "string",
              "example": "你好，你是谁？"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream opened",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-Sent Events stream. Each event contains JSON in the `data` field."
                },
                "examples": {
                  "content": {
                    "summary": "Content event",
                    "value": "event: content\ndata: {\"text\":\"你好\"}\n\n"
                  },
                  "done": {
                    "summary": "Done event",
                    "value": "event: done\ndata: {}\n\n"
                  },
                  "error": {
                    "summary": "Error event",
                    "value": "event: error\ndata: {\"message\":\"Model not found\"}\n\n"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "OpenAIStream": {
        "description": "OpenAI-compatible SSE stream",
        "content": {
          "text/event-stream": {
            "schema": {
              "type": "string"
            },
            "examples": {
              "content": {
                "summary": "Content chunk",
                "value": "data: {\"choices\":[{\"delta\":{\"content\":\"你好\"}}]}\n\n"
              },
              "done": {
                "summary": "Done chunk",
                "value": "data: [DONE]\n\n"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "OpenAIChatRequest": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "model": {
            "type": "string",
            "example": "glm-4.5-flash"
          },
          "stream": {
            "type": "boolean",
            "example": true
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "content"],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["user", "assistant", "system"],
                  "example": "user"
                },
                "content": {
                  "type": "string",
                  "example": "你好，你是谁？"
                }
              }
            }
          }
        },
        "additionalProperties": true
      },
      "ChatStreamEvent": {
        "type": "object",
        "description": "Logical event payload carried by the SSE `data` field.",
        "properties": {
          "text": {
            "type": "string",
            "description": "Streamed text content."
          },
          "message": {
            "type": "string",
            "description": "Error message when event type is `error`."
          }
        },
        "additionalProperties": true
      }
    }
  }
}
