{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrazyClaw",
  "version": "0.0.1-beta.0",
  "identifier": "com.crazyclaw.desktop",
  "build": {
    "frontendDist": "../../webui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @crazyclaw/webui dev",
    "beforeBuildCommand": "pnpm --filter @crazyclaw/webui build && pnpm --filter @crazyclaw/desktop prepare-sidecar"
  },
  "app": {
    "windows": [
      {
        "title": "CrazyClaw",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/server"],
    "externalBin": ["binaries/crazyclaw-node"]
  }
}
